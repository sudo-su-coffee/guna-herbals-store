# Required for database access and Drizzle migrations
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional payment configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product analytics: works with PostHog Cloud or a self-hosted PostHog URL
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Transactional email: SendGrid now, SMTP-compatible provider later
NOTIFICATIONS_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Guna's Herbals
NOTIFICATIONS_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Media storage and image delivery: Cloudinary is recommended for product imagery
MEDIA_PROVIDER=cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional S3-compatible object storage for raw files/backups
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Customer support: recommended provider is Chatwoot Cloud or self-hosted Chatwoot
SUPPORT_PROVIDER=chatwoot
SUPPORT_BASE_URL=
SUPPORT_WEBSITE_TOKEN=
NEXT_PUBLIC_SUPPORT_BASE_URL=
NEXT_PUBLIC_SUPPORT_WEBSITE_TOKEN=
SUPPORT_API_TOKEN=
SUPPORT_ACCOUNT_ID=
SUPPORT_INBOX_ID=

# Optional alternatives; configure at most one analytics platform initially
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Portable authentication migration target; leave disabled until selected and configured
AUTH_PROVIDER=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
