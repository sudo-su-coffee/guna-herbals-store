# Required for database access and Drizzle migrations
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional payment configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product analytics: works with PostHog Cloud or a self-hosted PostHog URL
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Transactional notifications provider (confirm whether this is SendTree or SendGrid)
NOTIFICATIONS_PROVIDER=
NOTIFICATIONS_API_URL=
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# S3-compatible object storage: Cloudflare R2 now, AWS S3 later if desired
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Portable authentication migration target; leave disabled until selected and configured
AUTH_PROVIDER=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
